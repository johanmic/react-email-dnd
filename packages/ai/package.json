{
  "name": "@react-email-dnd/ai",
  "author": "Johan Mickelin",
  "version": "0.1.0",
  "description": "AI utilities and block generators for react-email-dnd.",
  "keywords": [
    "react",
    "email",
    "dnd",
    "ai",
    "generators"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johanmic/react-email-dnd.git",
    "directory": "packages/ai"
  },
  "homepage": "https://dnd.email/docs/ai",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest --config ./jest.config.ts"
  },
  "dependencies": {
    "@react-email-dnd/shared": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  }
}
